{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:bg": "./scripts/start-dev-bg.sh",
    "dev:stop": "./scripts/stop-dev-bg.sh",
    "dev:logs": "cat .local-dev.log",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx platform/db/seed-cli.ts",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify": "pnpm typecheck && pnpm lint && pnpm build:check && pnpm test && pnpm test:e2e",
    "stripe:setup": "tsx platform/stripe/setup-prices.ts",
    "stripe:listen": "./scripts/stripe-listen.sh",
    "build:check": "NEXT_DIST_DIR=.next-build next build --turbopack"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.1146.0",
    "@hookform/resolvers": "^5.2.2",
    "@mux/mux-player-react": "^3.13.4",
    "@neondatabase/serverless": "^1.2.0",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@vercel/analytics": "^1.6.1",
    "@vercel/oidc-aws-credentials-provider": "^3.3.11",
    "better-auth": "^1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.3",
    "lucide-react": "^0.544.0",
    "motion": "^12.23.22",
    "next": "16.1.1",
    "react": "19.2.3",
    "react-confetti": "^6.4.0",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.64.0",
    "stripe": "^23.0.0",
    "swr": "^2.3.8",
    "tailwind-merge": "^3.3.1",
    "ws": "^8.22.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/ws": "^8.18.2",
    "dotenv": "^18.0.5",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3"
  }
