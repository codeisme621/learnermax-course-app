# LearnWithRico — environment variables (no secrets in this file).
# Local: copy to .env.local and fill in. Vercel: set per environment (see ../VERCEL_ENV_SETUP.md).

# ── Database (Neon Postgres) ────────────────────────────────────────────────
# Local: the Neon "dev" branch of learnwithrico-preview. Vercel: injected by the Neon integration.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
# Optional; drizzle-kit migrations prefer a direct connection when set (Vercel sets it).
# DATABASE_URL_UNPOOLED=

# ── Better Auth ────────────────────────────────────────────────────────────
# 32+ random bytes, different per environment:  openssl rand -base64 32
BETTER_AUTH_SECRET=
# The app's public origin. Also used for Stripe success/cancel URLs and email links.
BETTER_AUTH_URL=http://localhost:3000

# ── Google OAuth (optional; the Google button is hidden when unset) ─────────
# Local: ./scripts/pull-local-secrets.sh (AWS Secrets Manager: learnermax/google-oauth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Stripe ─────────────────────────────────────────────────────────────────
# Local/Preview: sandbox key (sk_test_…). Production: live key. Never a live key locally.
STRIPE_SECRET_KEY=
# Local: `stripe listen --print-secret` (pull-local-secrets.sh sets it).
# Vercel: the signing secret of that environment's Dashboard webhook endpoint.
STRIPE_WEBHOOK_SECRET=

# ── Email (AWS SES) ────────────────────────────────────────────────────────
# ses | capture  (capture writes JSON files to EMAIL_CAPTURE_DIR instead of sending; tests use it)
EMAIL_TRANSPORT=ses
EMAIL_FROM=LearnWithRico <hello@learnwithrico.com>
# Pin the SES region (Vercel otherwise sets AWS_REGION to the function's region).
AWS_REGION=us-east-1
# Vercel only: IAM role assumed through Vercel OIDC for SES. Locally, the default AWS credential chain is used.
# AWS_ROLE_ARN=arn:aws:iam::853219709625:role/learnwithrico-ses-sender
# EMAIL_CAPTURE_DIR=.email-capture

# ── Landing page ───────────────────────────────────────────────────────────
NEXT_PUBLIC_HERO_VIDEO_PLAYBACK_ID=

# ─────────────────────────────────────────────────────────────────────────────
# .env.test.local (separate file, used only by `pnpm test` / `pnpm test:e2e`):
#   DATABASE_URL=<Neon "test" branch of learnwithrico-preview>   ← wiped on every run
# Tests also read STRIPE_SECRET_KEY (sandbox only) from .env.local.

# ── Deployed environments only (see .claude/skills/external-systems/SKILL.md) ──
# Preview + production share this value; enables Google sign-in on dynamic preview URLs (OAuth proxy).
# OAUTH_PROXY_SECRET=
# AUTH_PRODUCTION_URL=https://www.learnwithrico.com
# Protects GET /api/ops/reconcile (pnpm ops:reconcile).
# OPS_SECRET=
